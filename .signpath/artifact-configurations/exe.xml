<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration d'artefact SignPath "exe" : Ocre.exe, a signer en Authenticode.

  L'artefact que le workflow depose (actions/upload-artifact) est une archive
  ZIP qui ne contient que Ocre.exe : d'ou l'element racine zip-file.
  A coller dans SignPath > projet > Artifact Configurations > Add > Custom,
  sous le slug "exe" (c'est ce que dit .github/workflows/release.yml).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Ocre.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
