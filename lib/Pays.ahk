;==============================================================================
;  Pays.ahk -- noms de pays, et la mise a plat des accents.
;
;  Deux services, qui n'en font qu'un : permettre a quelqu'un de taper le nom
;  de son pays dans sa langue et d'en tirer le code a deux lettres que porte
;  la table des villes.
;
;  Ce fichier est encode en UTF-8 AVEC BOM, comme I18n.ahk et pour la meme
;  raison : sans lui AutoHotkey lirait "Emirats" en ANSI. C'est aussi ce qui
;  permet d'ecrire la table des accents en clair plutot qu'en codes -- et
;  c'est pour cela que Simplifier vit ici et non dans Villes.ahk, qui est en
;  ASCII pur.
;==============================================================================

#Requires AutoHotkey v2.0

class Pays {

    ;--------------------------------------------------------------------------
    ;  Rabat les accents sur l'ASCII.
    ;
    ;  La table des villes est en ASCII pur : on rabat donc la saisie plutot
    ;  que d'accentuer 26 000 lignes. "Geneve" accentue ou non trouve Geneve.
    ;--------------------------------------------------------------------------
    static ACCENTS := "ÀÁÂÃÄÅÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖØÙÚÛÜÝàáâãäåçèéêëìíîïðñòóôõöøùúûüýÿŠšŽžŸ"
    static PLATS   := "AAAAAACEEEEIIIIDNOOOOOOUUUUYaaaaaaceeeeiiiidnoooooouuuuyySsZzY"

    static Simplifier(texte) {
        for paire in [["Æ", "AE"], ["æ", "ae"], ["Œ", "OE"], ["œ", "oe"], ["ß", "ss"]]
            texte := StrReplace(texte, paire[1], paire[2])

        sortie := ""
        Loop Parse texte {
            p := InStr(Pays.ACCENTS, A_LoopField, true)
            sortie .= p ? SubStr(Pays.PLATS, p, 1) : A_LoopField
        }
        return sortie
    }

    ;--------------------------------------------------------------------------
    ;  La meme mise a plat, mais a l'allemande.
    ;
    ;  GeoNames translittere les villes allemandes selon l'usage du pays :
    ;  Köln y est "Koeln", Düsseldorf "Duesseldorf". La mise a plat ordinaire
    ;  donne "Koln" et "Dusseldorf", qui ne trouvent rien. Les deux formes sont
    ;  donc essayees -- celle-ci ne coute que si la saisie porte un trema.
    ;--------------------------------------------------------------------------
    static Allemand(texte) {
        for paire in [["Ä", "Ae"], ["Ö", "Oe"], ["Ü", "Ue"]
                    , ["ä", "ae"], ["ö", "oe"], ["ü", "ue"], ["ß", "ss"]]
            texte := StrReplace(texte, paire[1], paire[2])
        return Pays.Simplifier(texte)
    }

    ;--------------------------------------------------------------------------
    ;  Nom affichable. Une langue inconnue retombe sur le francais, et un code
    ;  absent de la table se rend tel quel plutot que de disparaitre.
    ;--------------------------------------------------------------------------
    static Nom(cc, langue := "fr") {
        cc := StrUpper(Trim(cc))
        table := Pays.NOMS.Has(langue) ? Pays.NOMS[langue] : Pays.NOMS["fr"]
        return table.Has(cc) ? table[cc] : cc
    }

    ;--------------------------------------------------------------------------
    ;  Nom -> code. Accepte le code lui-meme, le nom francais, le nom anglais,
    ;  et le debut de l'un ou l'autre : "Fran" suffit pour la France.
    ;
    ;  Renvoie "" si rien ne correspond, ce qui laisse l'appelant traiter la
    ;  saisie comme une ville plutot que comme un pays.
    ;--------------------------------------------------------------------------
    static Code(texte) {
        texte := Pays.Simplifier(Trim(texte))
        if (texte = "")
            return ""

        if (StrLen(texte) = 2 && Pays.NOMS["fr"].Has(StrUpper(texte)))
            return StrUpper(texte)

        n := StrLen(texte)
        partiel := ""
        for langue, table in Pays.NOMS {
            for cc, nom in table {
                plat := Pays.Simplifier(nom)
                if (plat = texte)
                    return cc
                if (partiel = "" && SubStr(plat, 1, n) = texte)
                    partiel := cc
            }
        }
        return partiel
    }

